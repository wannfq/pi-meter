{
  "name": "@wannfq/pi-meter",
  "version": "0.2.0",
  "description": "Provider allowance windows for Pi — displayed in a compact /meter overlay.",
  "license": "MIT",
  "author": "wannfq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannfq/pi-meter.git"
  },
  "homepage": "https://github.com/wannfq/pi-meter#readme",
  "bugs": {
    "url": "https://github.com/wannfq/pi-meter/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "usage",
    "quota",
    "meter"
  ],
  "packageManager": "pnpm@11.18.0",
  "files": [
    "src",
    "examples",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "dev": "pi --no-extensions -e ./src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": false
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}